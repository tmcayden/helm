{
  "name": "helm-workspace",
  "version": "0.0.1",
  "description": "Portable desktop shell on top of Claude Code",
  "author": "Cole Taylor",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @helm/desktop dev",
    "dev:live": "pnpm --filter @helm/desktop dev:live",
    "build": "pnpm --filter @helm/desktop build",
    "start": "pnpm --filter @helm/desktop start",
    "typecheck": "pnpm -r --sequential typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "shell": "pnpm --filter @helm/desktop shell",
    "selftest": "pnpm --filter @helm/desktop selftest",
    "fidelity": "pnpm --filter @helm/desktop fidelity",
    "claude-check": "pnpm --filter @helm/desktop claude-check",
    "design-shot": "pnpm --filter @helm/desktop design-shot",
    "affordance-check": "pnpm --filter @helm/desktop affordance-check",
    "sessions-check": "pnpm --filter @helm/desktop sessions-check",
    "profiles-check": "pnpm --filter @helm/desktop profiles-check",
    "history-check": "pnpm --filter @helm/desktop history-check",
    "config-check": "pnpm --filter @helm/desktop config-check",
    "content-check": "pnpm --filter @helm/desktop content-check",
    "packaging-check": "pnpm --filter @helm/desktop packaging-check",
    "verify:installer": "pnpm --filter @helm/desktop verify:installer",
    "usage-check": "pnpm --filter @helm/desktop usage-check",
    "settings-check": "pnpm --filter @helm/desktop settings-check",
    "pr-check": "pnpm --filter @helm/desktop pr-check",
    "transcript-check": "pnpm --filter @helm/desktop transcript-check",
    "template-check": "pnpm --filter @helm/desktop template-check",
    "browser-check": "pnpm --filter @helm/desktop browser-check",
    "highlight-check": "pnpm --filter @helm/desktop highlight-check",
    "dist:win": "pnpm --filter @helm/desktop dist:win",
    "install:local": "pnpm --filter @helm/desktop install:local",
    "verify:artifact": "pnpm --filter @helm/desktop verify:artifact",
    "db:generate": "pnpm --filter @helm/core db:generate",
    "icon": "pnpm --filter @helm/desktop icon"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
